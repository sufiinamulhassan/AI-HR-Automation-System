# Copy to .env and fill in. Unlisted keys have defaults in config/settings.py.

# REQUIRED - 32+ random chars, signs every JWT: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# REQUIRED - seeded on the first database connection; password 12+ chars, not a common one
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=

# REQUIRED - on Vercel this must be an Atlas SRV string, cluster network access 0.0.0.0/0
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=hr_bot

# REQUIRED - JD parsing, matching, interviews, embeddings, TTS and transcription
OPENAI_API_KEY=

# REQUIRED - every candidate-facing link is built from this
FRONTEND_URL=http://localhost:5173

# RECOMMENDED - resume/JD vector matching; the index must have dimension 1536
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hr-bot
PINECONE_ENV=us-east-1

# RECOMMENDED - browser origins allowed to call this API, as a JSON array
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Verbose logging and relaxed startup checks; must be false on any real deploy
DEBUG=false

# Turns the startup audit's weak-value warnings into a refusal to boot
STRICT_SECURITY_VALIDATION=false

# DANGER - 'Bearer demo-<role>-token' grants any role with no credentials.
# Leave false on any real deploy.
ALLOW_DEMO_AUTH=false

# Hackathon-only: with ALLOW_DEMO_AUTH also true, powers the "Sign in with
# Google" button on the login page (logs the evaluator in as Super Admin
# with no real Google account) and blocks every delete/purge endpoint for
# that demo session so nothing is actually removed from the database.
# Leave false everywhere except the hackathon demo deployment.
HACKATHON_DEMO_MODE=false

# OPTIONAL - without EMAIL_HOST or AWS_SES_ENABLED no invite, OTP or offer email is sent
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=hr@company.com
EMAIL_FROM_NAME=HR Platform
EMAIL_USE_TLS=true

# OPTIONAL - alternative to SMTP
AWS_SES_ENABLED=false
AWS_SES_REGION=

# OPTIONAL - code execution for the coding assessment; the provider selects which pair is read
CODE_SANDBOX_PROVIDER=judge0
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
PISTON_API_URL=
PISTON_API_KEY=

# OPTIONAL - adds Claude models to the picker; not embeddings, TTS or transcription
ANTHROPIC_API_KEY=

# OPTIONAL - single sign-on
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# OPTIONAL - meeting links on scheduled interviews; "zoom" or "teams", blank disables them
MEETING_PROVIDER=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
MS_TEAMS_TENANT_ID=
MS_TEAMS_CLIENT_ID=
MS_TEAMS_CLIENT_SECRET=
MS_TEAMS_ORGANIZER_USER_ID=

# OPTIONAL - signs outbound webhook payloads so receivers can verify them
WEBHOOK_SIGNING_SECRET=

# OPTIONAL - push hired candidates to an external HRMS
HRMS_WEBHOOK_URL=
HRMS_AUTH_HEADER=
HRMS_AUTH_TOKEN=
HRMS_AUTO_PUSH_ON_HIRE=false

# OPTIONAL - job board import; all blank means manual JD entry only
LINKEDIN_API_KEY=
NAUKRI_API_KEY=
DICE_API_KEY=
CAREERBUILDER_API_KEY=
INDEED_API_KEY=
JOB_IMPORT_SYNC_INTERVAL_HOURS=6

# Models
DEFAULT_LLM_MODEL=gpt-4o
RESUME_CLASSIFICATION_MODEL=gpt-4o-mini
RESUME_EMBEDDING_MODEL=text-embedding-3-small

# Matching - stored above SIMILARITY, auto-invited above AUTO_INVITE; these are tuned together
RESUME_SIMILARITY_THRESHOLD=0.35
AUTO_INVITE_THRESHOLD=0.70
RESUME_TOP_N_MATCHES_PER_JD=20
MAX_BULK_UPLOAD_FILES=500

# Interview
INTERVIEW_DURATION_MINUTES=30
INTERVIEW_QUESTION_COUNT=15
TTS_VOICE=alloy

# Auth session length and invite validity
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITE_LINK_EXPIRY_DAYS=7

# TESTS ONLY - the suite runs against these when set, so it never touches real data
MONGODB_TEST_URI=
MONGODB_TEST=hr_bot_test
PINECONE_API_KEY_TEST=
PINECONE_INDEX_NAME_TEST=hr-bot-test
